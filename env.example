# ============================================================
#  CINDYMARY COUTURE — Environment Variables
#  Save this as .env in your backend folder
#  NEVER commit this file to GitHub
# ============================================================

# Supabase (get from supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Resend (get from resend.com → API Keys)
RESEND_API_KEY=re_your_api_key_here

# Your deployed frontend URL
FRONTEND_URL=https://cindymarycouture.com

# Port (Railway/Render set this automatically)
PORT=4000
